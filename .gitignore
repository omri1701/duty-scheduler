# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# Ignore artifacts left in existing checkouts by the retired runtime.
/.vinext/
/dist/
/.wrangler/
/.sites-runtime/
.dev.vars*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
# Share only reviewed AI instructions; keep credentials and local state ignored.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/scheduling-regression/
!/.agents/skills/code-change-validation/
!/.agents/skills/security-review/
!/.agents/skills/feature-delivery/
/.agents/skills/*/*
!/.agents/skills/*/SKILL.md
/.codex/*
!/.codex/config.toml
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/qa.toml
!/.codex/agents/security.toml
/outputs/
/work/

*.tsbuildinfo

# Supabase CLI cache
/supabase/.temp/
/supabase/.branches/
