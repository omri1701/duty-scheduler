# Copy to .env.local for native Next.js development (port 5173).
# DEV defaults to the existing Frankfurt Development project.
# LOCAL gets an isolated CLI URL/public key automatically: pnpm dev:local.
# PROD inspection uses ignored .env.prod.local: SUPABASE_PROD_PUBLISHABLE_KEY.
# Vercel Production uses the production pair; Preview/Development use the dev pair.
# Never give Preview the production URL/key, including branch-specific overrides.
# Only the publishable key is supported; never use a secret/service-role key.
SUPABASE_URL=https://qhndiuahuxczujxxitsm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
