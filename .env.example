# Copy to .env.local for native Next.js development (port 5173).
# Use a separate development project with synthetic data only.
# Vercel Production uses the production pair; Preview/Development use the dev pair.
# Never give Preview the production URL/key, including branch-specific overrides.
# Only the publishable key is supported; never use a secret/service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
