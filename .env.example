# Copy to .env.local for native Next.js development (port 5173).
# DEV defaults to the existing Frankfurt Development project.
# LOCAL gets an isolated CLI URL/public key automatically: pnpm start:local.
# PROD inspection uses ignored .env.prod.local: SUPABASE_PROD_PUBLISHABLE_KEY.
# Vercel Production uses the production pair; Preview/Development use the dev pair.
# Never give Preview the production URL/key, including branch-specific overrides.
# Only the publishable key is supported; never use a secret/service-role key.
SUPABASE_URL=https://qhndiuahuxczujxxitsm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional mobile DEV: set your exact static HTTPS ngrok origin in .env.dev.local.
# DUTY_DEV_ORIGIN=https://your-assigned-domain.ngrok-free.app
# Optional web push (server-only; never NEXT_PUBLIC). pnpm push:setup local writes these.
# VAPID_SUBJECT must be a real mailto: address or an https URL (your ngrok origin or the app's URL):
# Apple refuses every send signed with a placeholder such as example.com or .invalid.
# Hosted DEV/PROD get their own keys in Vercel; see docs/SUPABASE_SETUP.md#web-push-notifications.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://miko-prod.vercel.app
# DUTY_PUSH_SECRET=at-least-32-random-characters
